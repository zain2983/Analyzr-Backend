# Copy to .env (or export these) for local development.
#
# The CORS allowlist defaults to the production origin only, so a locally-run
# frontend is refused until one of these is set. See README.md.

# Adds http://localhost:3000 to the CORS allowlist.
ANALYZR_ENV=development

# Explicit allowlist; overrides ANALYZR_ENV when set. Comma-separated.
# ALLOWED_ORIGINS=https://analyzr-z1.vercel.app,http://localhost:3000
